{
  "bookSourceName": "聚热文学",
  "bookSourceUrl": "https://www.jurewx.com",
  "bookSourceGroup": "自定义",
  "bookSourceType": 0,
  "enabled": false,
  "charset": "utf-8",
  "searchUrl": "/search.html",
  "searchMethod": "POST",
  "searchBody": "s={{key}}",
  "searchCharset": "utf-8",
  "ruleSearch": {
    "bookList": ".sort_list li",
    "name": ".s2 a",
    "author": ".s5",
    "bookUrl": ".s2 a@href"
  },
  "ruleBookInfo": {
    "name": "meta[property=\"og:novel:book_name\"]@content",
    "author": "meta[property=\"og:novel:author\"]@content",
    "coverUrl": "meta[property=\"og:image\"]@content",
    "intro": "meta[property=\"og:description\"]@content",
    "kind": "meta[property=\"og:novel:category\"]@content",
    "status": "meta[property=\"og:novel:status\"]@content",
    "lastChapter": "meta[property=\"og:novel:latest_chapter_name\"]@content"
  },
  "ruleToc": {
    "chapterList": ".chapter-list li",
    "chapterName": "a",
    "chapterUrl": "a@href"
  },
  "ruleContent": {
    "title": "#chaptername",
    "content": "#txt",
    "decode": "base64-script"
  },
  "replaceRules": [],
  "tocReverse": false,
  "singleChapter": false
}
